@model TailSpin.SpaceGame.Web.Models.LeaderboardViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnv
@{
    ViewData["Title"] = "Início";
    var deploy = TailSpin.SpaceGame.Web.Models.DeploymentInfo.Load(HostEnv.WebRootPath);

    // Etapas do pipeline, na ordem em que acontecem.
    var etapas = new[]
    {
        new { Chave = "commit",   Titulo = "Commit no GitHub",   Texto = "Uma alteração no código dispara o pipeline sozinho." },
        new { Chave = "build",    Titulo = "Compilação",         Texto = "O Azure Pipelines compila o jogo e gera o pacote drop." },
        new { Chave = "dev",      Titulo = "Desenvolvimento",    Texto = "O pacote é publicado automaticamente neste ambiente." },
        new { Chave = "aprovacao",Titulo = "Aprovação",          Texto = "Uma pessoa revisa e libera a próxima etapa." },
        new { Chave = "staging",  Titulo = "Homologação",        Texto = "O mesmo pacote é publicado para a validação final." },
    };
}

@if (deploy.HasMessage)
{
    <aside class="live-banner" aria-label="Recado publicado pelo pipeline">
        <div class="live-inner">
            <span class="live-tag">Recado ao vivo</span>
            <p class="live-text">@deploy.Message</p>
            @if (deploy.HasBuild)
            {
                <span class="live-build">Publicado pela compilação #@deploy.BuildNumber</span>
            }
        </div>
    </aside>
}

<header class="hero">
    <div class="hero-inner">
        <div class="hero-text">
            <h1 class="hero-title">Space Game</h1>
            <p class="hero-lead">Pilote entre galáxias, desvie de asteroides e dispute o topo do ranking.</p>
            <p class="hero-sub">Este site é publicado automaticamente pelo Azure DevOps a cada alteração no código.</p>
            <div class="hero-actions">
                <a class="btn-primary" href="#ranking">Ver o ranking</a>
                <a class="btn-ghost" href="#pipeline">Como este site chegou aqui</a>
            </div>
        </div>
        <img class="hero-art" src="/images/hero-space.svg" alt="Foguete passando por um planeta com anéis" width="1200" height="720">
    </div>
</header>

<section class="console env-@deploy.EnvironmentKey" aria-label="Informações da publicação">
    <div class="console-inner">
        <div class="console-env">
            <span class="signal" aria-hidden="true"></span>
            <div>
                <p class="console-caption">Você está vendo o ambiente de</p>
                <p class="console-env-name">@deploy.EnvironmentName</p>
            </div>
        </div>
        <dl class="console-data">
            <div>
                <dt>Compilação</dt>
                <dd>@(deploy.HasBuild ? "#" + deploy.BuildNumber : "sem pipeline")</dd>
            </div>
            <div>
                <dt>Site no Azure</dt>
                <dd>@(string.IsNullOrEmpty(deploy.SiteName) ? "rodando localmente" : deploy.SiteName)</dd>
            </div>
            @if (!string.IsNullOrEmpty(deploy.Region))
            {
                <div>
                    <dt>Região</dt>
                    <dd>@deploy.Region</dd>
                </div>
            }
            <div>
                <dt>Runtime</dt>
                <dd>@deploy.Runtime</dd>
            </div>
        </dl>
    </div>
</section>

<section class="pipeline" id="pipeline">
    <div class="wrap">
        <h2>Do código ao ar, sem cliques manuais</h2>
        <p class="section-lead">Cada versão deste site passa pelas mesmas etapas do Azure Pipelines. A etapa destacada é a que gerou a página que você está vendo.</p>
        <ol class="steps">
            @foreach (var etapa in etapas)
            {
                var atual = etapa.Chave == deploy.EnvironmentKey;
                <li class="step@(atual ? " is-current" : "")">
                    <h3>@etapa.Titulo</h3>
                    <p>@etapa.Texto</p>
                    @if (atual)
                    {
                        <span class="here">Você está aqui</span>
                    }
                </li>
            }
        </ol>
    </div>
</section>

<section class="galaxies">
    <div class="wrap">
        <h2>Três galáxias para explorar</h2>
        <div class="gallery">
            <figure>
                <img src="/images/scene-asteroides.svg" alt="Foguete atravessando um cinturão de asteroides" width="800" height="500" loading="lazy">
                <figcaption><strong>Cinturão de asteroides</strong> Desvie das rochas e mantenha a velocidade.</figcaption>
            </figure>
            <figure>
                <img src="/images/scene-galaxia.svg" alt="Galáxia espiral com duas naves" width="800" height="500" loading="lazy">
                <figcaption><strong>Galáxia espiral</strong> Corra contra outros pilotos pelos braços da espiral.</figcaption>
            </figure>
            <figure>
                <img src="/images/scene-pouso.svg" alt="Foguete pousado em um planeta sob uma nebulosa" width="800" height="500" loading="lazy">
                <figcaption><strong>Pouso na nebulosa</strong> Chegue inteiro e finque sua bandeira.</figcaption>
            </figure>
        </div>
    </div>
</section>

<section class="ranking" id="ranking">
    <div class="wrap">
        <h2>Ranking dos pilotos</h2>
        <div class="ranking-layout">
            <div class="ranking-table">
                <table>
                    <thead>
                        <tr>
                            <th scope="col" class="col-pos">Posição</th>
                            <th scope="col">Piloto</th>
                            <th scope="col" class="col-mode">Modo</th>
                            <th scope="col" class="col-region">Galáxia</th>
                            <th scope="col" class="col-score">Pontos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rank = ((Model.Page - 1) * Model.PageSize) + 1;
                        }
                        @if (Model.Scores.Count() == 0)
                        {
                            <tr><td colspan="5" class="empty">Nenhum piloto neste filtro. Escolha outro modo ou galáxia.</td></tr>
                        }
                        @foreach (var score in Model.Scores)
                        {
                            var pos = rank++;
                            <tr class="@(pos <= 3 ? "top top-" + pos : "")">
                                <td class="col-pos">@(pos)º</td>
                                <td>
                                    <partial name="Profile" model="new ProfileViewModel { Profile = score.Profile, Rank = pos.ToString() }" />
                                    <a class="player" href="" data-toggle="modal" data-target="#profile-modal-@pos">
                                        <img class="avatar" src="/@score.Profile.AvatarUrl" alt="">
                                        <span>@score.Profile.UserName</span>
                                    </a>
                                </td>
                                <td class="col-mode">@score.Score.GameMode</td>
                                <td class="col-region">@score.Score.GameRegion</td>
                                <td class="col-score">@score.Score.HighScore.ToString("N0", new System.Globalization.CultureInfo("pt-BR"))</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @{
                    var totalPages = Model.TotalResults / Model.PageSize;
                    if (Model.TotalResults % Model.PageSize != 0) { totalPages++; }
                }
                @if (totalPages > 1)
                {
                    <nav class="pages" aria-label="Páginas do ranking">
                        @if (!string.IsNullOrEmpty(Model.PrevLink))
                        {
                            <a href="@Model.PrevLink">Anterior</a>
                        }
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == Model.Page)
                            {
                                <span class="current" aria-current="page">@i</span>
                            }
                            else
                            {
                                <a href="@($"/?page={i}&pageSize={Model.PageSize}&mode={Model.SelectedMode}&region={Model.SelectedRegion}")#ranking">@i</a>
                            }
                        }
                        @if (!string.IsNullOrEmpty(Model.NextLink))
                        {
                            <a href="@Model.NextLink">Próxima</a>
                        }
                    </nav>
                }
            </div>

            <aside class="filters" aria-label="Filtros do ranking">
                <h3>Modo de jogo</h3>
                <ul>
                    <li>
                        @if (string.IsNullOrEmpty(Model.SelectedMode))
                        {
                            <span class="chip is-active">Todos</span>
                        }
                        else
                        {
                            <a class="chip" href="/?region=@Model.SelectedRegion#ranking">Todos</a>
                        }
                    </li>
                    @foreach (var mode in Model.GameModes)
                    {
                        <li>
                            @if (mode.Equals(Model.SelectedMode))
                            {
                                <span class="chip is-active">@mode</span>
                            }
                            else
                            {
                                <a class="chip" href="/?mode=@mode&region=@Model.SelectedRegion#ranking">@mode</a>
                            }
                        </li>
                    }
                </ul>

                <h3>Galáxia</h3>
                <ul>
                    <li>
                        @if (string.IsNullOrEmpty(Model.SelectedRegion))
                        {
                            <span class="chip is-active">Todas</span>
                        }
                        else
                        {
                            <a class="chip" href="/?mode=@Model.SelectedMode#ranking">Todas</a>
                        }
                    </li>
                    @foreach (var region in Model.GameRegions)
                    {
                        <li>
                            @if (region.Equals(Model.SelectedRegion))
                            {
                                <span class="chip is-active">@region</span>
                            }
                            else
                            {
                                <a class="chip" href="/?mode=@Model.SelectedMode&region=@region#ranking">@region</a>
                            }
                        </li>
                    }
                </ul>
            </aside>
        </div>
    </div>
</section>

<footer class="site-footer">
    <div class="wrap">
        <p class="footer-title">Seminário de Computação em Nuvem e Microsoft Azure</p>
        <p>Fatec Rio Preto, disciplina de Sistemas Operacionais, Prof. Lucimar.</p>
        <p>Guilherme, Henrique, João Pedro Amaro e José Pedro.</p>
        <p class="footer-note">Space Game é um projeto de exemplo da Microsoft para aprender Azure DevOps. A TailSpin Toys é uma empresa fictícia. &copy; @DateTime.Now.Year</p>
    </div>
</footer>
