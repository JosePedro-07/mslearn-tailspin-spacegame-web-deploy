@model TailSpin.SpaceGame.Web.Models.ProfileViewModel
<div class="modal fade profile" id="profile-modal-@Model.Rank" tabindex="-1" role="dialog" aria-labelledby="profile-title-@Model.Rank">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <button type="button" class="close" data-dismiss="modal" aria-label="Fechar">&times;</button>
            <div class="profile-body">
                <img class="profile-avatar" src="/@Model.Profile.AvatarUrl" alt="">
                <div>
                    <h2 id="profile-title-@Model.Rank">@Model.Profile.UserName</h2>
                    <p class="profile-rank">@(Model.Rank)º lugar no ranking</p>
                    <h3>Conquistas</h3>
                    <ul class="badges">
                        @foreach (var achievement in Model.Profile.Achievements.Distinct())
                        {
                            <li>@achievement</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
